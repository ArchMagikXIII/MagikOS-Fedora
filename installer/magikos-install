#!/bin/bash

# Magikos in-repo installer. Two modes:
#
#   Full-disk install: boots from any live media with network access, wipes a
#   disk, installs Magikos onto it, and hands off to the same target-side
#   setup the packaged ISO uses (magikos-apply-system in the target chroot).
#
#   Existing-system adoption (--existing): applies Magikos onto the currently
#   running system — plants the tree, best-effort packages, then
#   magikos-apply-system directly. No partitioning, no bootloader changes.
#
# Usage: sudo ./installer/magikos-install --disk /dev/sdX --user alice [options]
#        sudo ./installer/magikos-install --existing [options]
# See installer/README.md for the full contract and current limitations.

set -euo pipefail

ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
TARGET="/mnt"
LUKS_NAME="cryptroot"

DISK=""
INSTALL_USER=""
HOSTNAME=""
TIMEZONE=""
ENCRYPT=1
BACKEND="${MAGIKOS_PKG_BACKEND:-}"
ASSUME_YES=0
DRY_RUN=0
EXISTING_MODE=0

LOG_FILE="${MAGIKOS_INSTALL_LOG_FILE:-/tmp/magikos-install.log}"
PKG_FAILURES=()

log() {
  printf '\033[32m==> %s\033[0m\n' "$1"
}

warn() {
  printf '\033[33m==> %s\033[0m\n' "$1" >&2
}

die() {
  printf '\033[31mError: %s\033[0m\n' "$1" >&2
  exit 1
}

usage() {
  cat <<USAGE
Usage:
  magikos-install --disk DEVICE --user NAME [options]   full-disk install (wipes the disk)
  magikos-install --existing [--user NAME] [options]    adopt the currently running system

Required for full-disk install:
  --disk DEVICE     Target disk (whole device, e.g. /dev/vda). Its contents are destroyed.
  --user NAME       Non-root user to create.

Options:
  --existing        Adopt the running system: no partitioning, no bootloader changes.
                    Defaults to the invoking user when --user is omitted.
  --hostname NAME   Target hostname (default: magikos; ignored with --existing)
  --timezone TZ     IANA timezone (default: the live media's timezone; ignored with --existing)
  --no-encrypt      Skip LUKS2 encryption of the root partition
  --backend BE      pacman | dnf | auto (default: auto-detect on the live media)
  --yes             Assume yes; do not ask before wiping the disk
  --dry-run         Print every action without touching anything
  -h, --help        This help
USAGE
}

while (($#)); do
  case "$1" in
    --disk) DISK="$2"; shift 2 ;;
    --user) INSTALL_USER="$2"; shift 2 ;;
    --hostname) HOSTNAME="$2"; shift 2 ;;
    --timezone) TIMEZONE="$2"; shift 2 ;;
    --no-encrypt) ENCRYPT=0; shift ;;
    --backend) BACKEND="$2"; shift 2 ;;
    --yes) ASSUME_YES=1; shift ;;
    --dry-run) DRY_RUN=1; shift ;;
    --existing) EXISTING_MODE=1; shift ;;
    -h|--help) usage; exit 0 ;;
    *) echo "Unknown option: $1" >&2; usage >&2; exit 1 ;;
  esac
done

run() {
  if (( DRY_RUN )); then
    printf '[dry-run] %s\n' "$*"
  else
    "$@"
  fi
}

# All file writes go through here so --dry-run genuinely touches nothing.
write_file() {
  local path="$1" content="$2"
  if (( DRY_RUN )); then
    printf '[dry-run] write %s (%s bytes)\n' "$path" "${#content}"
  else
    run mkdir -p "$(dirname "$path")"
    printf '%s' "$content" >"$path"
  fi
}

# Everything that must happen inside the target goes through here, so the
# virtual kernels are bound once and the same call works for both backends.
chroot_exec() {
  local cmd="$1"
  if (( DRY_RUN )); then
    printf '[dry-run] chroot %s: %s\n' "$TARGET" "$cmd"
  else
    chroot "$TARGET" /bin/bash -lc "$cmd"
  fi
}

require_tools() {
  local missing=()
  local tool
  for tool in "$@"; do
    command -v "$tool" >/dev/null 2>&1 || missing+=("$tool")
  done
  if ((${#missing[@]} > 0)); then
    die "Missing required tools on the live media: ${missing[*]}"
  fi
}

# --- Arch -> dnf name translation (installer/dnf.map) ---

declare -A DNF_MAP

# quickshell only ships for Fedora through COPR; the repo file is written
# directly so the dnf copr plugin is not a dependency. skip_if_unavailable
# keeps releases without COPR chroots from poisoning every transaction.
QUICKSHELL_COPR_REPO=$(cat <<'REPO'
[errornointernet-quickshell]
name=Copr repo for quickshell owned by errornointernet
baseurl=https://download.copr.fedorainfracloud.org/results/errornointernet/quickshell/fedora-44-x86_64/
type=rpm-md
skip_if_unavailable=False
repo_gpgcheck=1
gpgcheck=1
enabled=1
gpgkey=https://download.copr.fedorainfracloud.org/results/errornointernet/quickshell/pubkey.gpg
REPO
)

add_quickshell_repo() {
  local etc_dir="$1"
  write_file "$etc_dir/yum.repos.d/_copr_errornointernet-quickshell.repo" \
    "$QUICKSHELL_COPR_REPO"$'\n'
}

load_dnf_map() {
  local line arch specs
  while IFS= read -r line; do
    [[ $line =~ ^[^#[:space:]] ]] || continue
    arch=${line%%|*}
    specs=${line#*|}
    DNF_MAP[$arch]=$specs
  done <"$ROOT/installer/dnf.map"
}

# Prints the dnf specs to attempt for one Arch name: its mapping expanded,
# nothing when mapped away, or the name itself when unmapped.
translate_one() {
  local pkg="$1"
  if [[ ${DNF_MAP[$pkg]+set} ]]; then
    if [[ ${DNF_MAP[$pkg]} == "-" ]]; then
      return 0
    fi
    local specs
    IFS=',' read -ra specs <<<"${DNF_MAP[$pkg]}"
    printf '%s\n' "${specs[@]}"
  else
    printf '%s\n' "$pkg"
  fi
}

# Fills TRANSLATED_PACKAGES with the dnf specs for the given Arch names.
translate_packages() {
  TRANSLATED_PACKAGES=()
  local pkg spec
  while read -r pkg; do
    [[ -n $pkg ]] || continue
    while read -r spec; do
      TRANSLATED_PACKAGES+=("$spec")
    done < <(translate_one "$pkg")
  done < <(printf '%s\n' "$@")
}

ask_confirm() {
  if (( ASSUME_YES || DRY_RUN )); then
    return 0
  fi
  local question="$1"
  if command -v gum >/dev/null 2>&1; then
    gum confirm --default=false "$question"
  else
    read -r -p "$question [y/N] " reply
    [[ $reply == y || $reply == Y ]]
  fi
}

ask_password() {
  local prompt="$1" pass confirm
  while :; do
    read -rs -p "$prompt: " pass
    echo
    read -rs -p "Confirm: " confirm
    echo
    if [[ -n $pass && $pass == "$confirm" ]]; then
      break
    fi
    echo "Passwords empty or mismatched; try again." >&2
  done
  printf '%s' "$pass"
}

preflight() {
  if (( EUID != 0 )); then
    die "Run as root (sudo)."
  fi

  export MAGIKOS_PATH="$ROOT"
  source "$ROOT/bin/magikos-pkg-backend"

  if [[ -z $BACKEND ]]; then
    BACKEND=$MAGIKOS_PKG_BACKEND
  elif [[ $BACKEND != "$MAGIKOS_PKG_BACKEND" ]]; then
    warn "Requested backend '$BACKEND' differs from live media ('${MAGIKOS_PKG_BACKEND}'); proceeding anyway."
  fi

  require_tools rsync

  export MAGIKOS_INSTALL_LOG_FILE="$LOG_FILE"

  if (( EXISTING_MODE )); then
    if [[ -z $INSTALL_USER ]]; then
      INSTALL_USER=${SUDO_USER:-}
    fi
    if [[ -z $INSTALL_USER || $INSTALL_USER == "root" ]]; then
      die "--existing needs --user NAME (or run under sudo so \$SUDO_USER resolves; got: ${INSTALL_USER:-nothing})."
    fi
    log "Adopting the running system: backend $BACKEND, user $INSTALL_USER"
    if ! ask_confirm "Install Magikos onto the running system? Shipped defaults will overwrite matching files in ~$INSTALL_USER at next login."; then
      die "Aborted."
    fi
    return 0
  fi

  case $BACKEND in
    pacman) require_tools pacstrap genfstab mkinitcpio sgdisk ;;
    dnf) require_tools dnf sgdisk ;;
  esac

  require_tools cryptsetup sfdisk blkid lsblk

  if [[ ! -d /sys/firmware/efi ]]; then
    die "Machine is not booted in UEFI mode."
  fi

  if [[ -z $DISK || ! -b $DISK ]]; then
    die "--disk must name a block device (got: ${DISK:-nothing})."
  fi

  if [[ -z $INSTALL_USER || $INSTALL_USER == "root" ]]; then
    die "--user must name the non-root user to create."
  fi

  if findmnt -rn -S "$DISK" >/dev/null 2>&1 || findmnt -rn -S "${DISK}2" >/dev/null 2>&1; then
    warn "Partitions on $DISK are mounted; they will be unmounted."
  fi

  [[ -n $HOSTNAME ]] || HOSTNAME="magikos"

  if [[ -z $TIMEZONE ]] && command -v timedatectl >/dev/null 2>&1; then
    TIMEZONE=$(timedatectl show -p Timezone --value 2>/dev/null || true)
  fi
  [[ -n $TIMEZONE ]] || TIMEZONE="UTC"

  log "Backend: $BACKEND   Disk: $DISK   User: $INSTALL_USER   Encrypt: $((ENCRYPT ? 1 : 0))"

  if ! ask_confirm "Erase ALL data on $DISK and install Magikos?"; then
    die "Aborted."
  fi
}

unmount_target() {
  run swapoff -a || true
  run umount -R "$TARGET" || true
  if (( ENCRYPT )); then
    run cryptsetup close "$LUKS_NAME" || true
  fi
}

partition_disk() {
  log "Partitioning $DISK"

  run swapoff -a || true
  local part mnt
  while read -r part; do
    while read -r mnt; do
      run umount -R "$mnt" || true
    done < <(findmnt -rn -S "$part" -o TARGET || true)
  done < <(lsblk -nrp -o NAME,TYPE "$DISK" | awk '$2 == "part" {print $1}')
  run wipefs -a "$DISK"

  # p1: EFI system partition. p2: everything else, optionally LUKS2 under it.
  run sgdisk -Z "$DISK"
  run sgdisk -n 1:0:+1G -t 1:ef00 -c 1:"ESP" "$DISK"
  run sgdisk -n 2:0:0 -t 2:8309 -c 2:"magikos-root" "$DISK"
  run partprobe "$DISK"

  run mkfs.fat -F32 -n "MAGIKOS" "${DISK}1"

  if (( ENCRYPT )); then
    run cryptsetup luksFormat --type luks2 --batch-mode "${DISK}2"
    run cryptsetup open "${DISK}2" "$LUKS_NAME"
    ROOT_DEVICE="/dev/mapper/$LUKS_NAME"
  else
    ROOT_DEVICE="${DISK}2"
  fi

  run mkfs.btrfs -f -L "magikos" "$ROOT_DEVICE"

  # Subvolume layout: @ for root, @home for /home. Snapper watches @ (see
  # default/snapper/root) and Limine boots snapshots of it.
  run mount "$ROOT_DEVICE" "$TARGET"
  run btrfs subvolume create "$TARGET/@"
  run btrfs subvolume create "$TARGET/@home"
  run umount "$TARGET"

  local root_opts="noatime,compress=zstd:1,subvol=@"
  run mkdir -p "$TARGET"
  run mount -o "$root_opts" "$ROOT_DEVICE" "$TARGET"
  run mkdir -p "$TARGET/home" "$TARGET/boot"
  run mount -o "noatime,compress=zstd:1,subvol=@home" "$ROOT_DEVICE" "$TARGET/home"
  run mount "${DISK}1" "$TARGET/boot"

  ROOT_UUID=$(blkid -s UUID -o value "$ROOT_DEVICE")
  LUKS_UUID=$(blkid -s UUID -o value "${DISK}2" || true)
  if [[ -z $ROOT_UUID ]]; then
    die "Could not read the root filesystem UUID from $ROOT_DEVICE"
  fi
  if (( ENCRYPT )) && [[ -z $LUKS_UUID ]]; then
    die "Could not read the LUKS UUID from ${DISK}2"
  fi
}

seed_target_config() {
  log "Seeding target configuration"

  if [[ -d $ROOT/etc ]]; then
    sync_etc_dropins "$TARGET/etc"
  fi

  # Arch's encrypt hook unlocks from /etc/crypttab.initramfs inside the
  # initramfs; dracut (Fedora) copies the real /etc/crypttab and needs
  # rd.luks.uuid on the kernel command line. The root= line is shared.
  if (( ENCRYPT )); then
    write_file "$TARGET/etc/crypttab.initramfs" "$LUKS_NAME UUID=$LUKS_UUID none luks,discard"$'\n'
    write_file "$TARGET/etc/crypttab" "$LUKS_NAME UUID=$LUKS_UUID none luks,discard"$'\n'
    write_file "$TARGET/etc/kernel/cmdline" \
      "$(printf 'root=UUID=%s rootflags=subvol=@ rw rd.luks.uuid=%s\n' "$ROOT_UUID" "$LUKS_UUID")"
  else
    write_file "$TARGET/etc/kernel/cmdline" \
      "$(printf 'root=UUID=%s rootflags=subvol=@ rw\n' "$ROOT_UUID")"
  fi

  write_file "$TARGET/etc/hostname" "$HOSTNAME"$'\n'
  write_file "$TARGET/etc/hosts" "$(cat <<EOF
127.0.0.1 localhost
::1 localhost
127.0.1.1 $HOSTNAME.localdomain $HOSTNAME
EOF
)"
  write_file "$TARGET/etc/locale.gen" "en_US.UTF-8 UTF-8"$'\n'
  write_file "$TARGET/etc/locale.conf" "LANG=en_US.UTF-8"$'\n'
  write_file "$TARGET/etc/timezone" "$TIMEZONE"$'\n'
  write_file "$TARGET/etc/sudoers.d/10-magikos-wheel" '%wheel ALL=(ALL:ALL) ALL'$'\n'
  if (( ! DRY_RUN )); then
    chmod 440 "$TARGET/etc/sudoers.d/10-magikos-wheel"
  fi
}

bootstrap_arch() {
  log "Bootstrapping Arch base system (pacstrap)"

  # Limine goes in before the kernel so the mkinitcpio hook deploys the UKI
  # as part of the kernel transaction itself. limine-mkinitcpio-hook and
  # limine-snapper-sync are AUR-only on vanilla Arch media, so this batch is
  # best effort too: a hard abort here would strand a freshly wiped disk.
  local base_pkgs=(
    base base-devel linux linux-firmware linux-headers \
    btrfs-progs dosfstools e2fsprogs sudo git \
    limine limine-mkinitcpio-hook limine-snapper-sync snapper \
    networkmanager sddm sway uwsm foot polkit gnome-keyring \
    pipewire wireplumber plymouth ufw gum rsync jq openssh
  )
  if ! run pacstrap -K "$TARGET" "${base_pkgs[@]}"; then
    warn "Base batch install failed; falling back to per-package installs."
    local pkg
    for pkg in "${base_pkgs[@]}"; do
      if (( DRY_RUN )); then
        printf '[dry-run] pacstrap -K %s: %s\n' "$TARGET" "$pkg"
      elif ! pacstrap -K "$TARGET" "$pkg" >>"$LOG_FILE" 2>&1; then
        PKG_FAILURES+=("$pkg")
      fi
    done
  fi

  log "Installing Magikos package set (best effort)"

  mapfile -t packages < <(grep -v '^#' "$ROOT/install/magikos-base.packages" | grep -v '^$')
  if (( ${#packages[@]} == 0 )); then
    die "No packages found in install/magikos-base.packages"
  fi
  if ! run pacstrap "$TARGET" "${packages[@]}"; then
    warn "Batch install failed; falling back to per-package installs."
    local pkg
    for pkg in "${packages[@]}"; do
      if (( DRY_RUN )); then
        printf '[dry-run] pacstrap %s: %s\n' "$TARGET" "$pkg"
      elif ! pacstrap "$TARGET" "$pkg" >>"$LOG_FILE" 2>&1; then
        PKG_FAILURES+=("$pkg")
      fi
    done
  fi

  # Scriptlets and chroot_exec need the virtual kernels inside the target;
  # pacstrap's own mounts live in a private namespace and vanish with it.
  run mount --rbind /dev "$TARGET/dev"
  run mount --make-rslave "$TARGET/dev"
  run mount -t proc /proc "$TARGET/proc"
  run mount --rbind /sys "$TARGET/sys"
  run mount --make-rslave "$TARGET/sys"
  run mount --rbind /run "$TARGET/run"
  run mount --make-rslave "$TARGET/run"
}

bootstrap_fedora() {
  log "Bootstrapping Fedora base system (dnf --installroot) [beta]"

  local releasever="${FEDORA_RELEASEVER:-44}"

  # Scriptlets need the virtual kernels inside the installroot.
  run mount --rbind /dev "$TARGET/dev"
  run mount --make-rslave "$TARGET/dev"
  run mount -t proc /proc "$TARGET/proc"
  run mount --rbind /sys "$TARGET/sys"
  run mount --make-rslave "$TARGET/sys"
  run mount --rbind /run "$TARGET/run"
  run mount --make-rslave "$TARGET/run"

  # --skip-broken keeps one unmapped name from killing the transaction; the
  # audit afterwards reports exactly what did not land. It sits after the
  # subcommand because dnf5 only accepts it there.
  local core_specs=(
    @core kernel kernel-modules kernel-modules-extra dracut systemd-ukify
    sudo git btrfs-progs dosfstools NetworkManager sddm sway uwsm foot
    polkit gnome-keyring pipewire pipewire-pulse wireplumber plymouth
    ufw gum rsync jq openssh-server
  )
  add_quickshell_repo "$TARGET/etc"
  mapfile -t packages < <(grep -v '^#' "$ROOT/install/magikos-base.packages" | grep -v '^$')
  load_dnf_map
  translate_packages "${packages[@]}"
  run dnf -y --installroot="$TARGET" --releasever="$releasever" \
    --setopt=install_weak_deps=False \
    install --skip-broken \
    "${core_specs[@]}" "${TRANSLATED_PACKAGES[@]}"

  if (( ! DRY_RUN )); then
    local pkg installed
    while read -r pkg; do
      [[ -n $pkg ]] || continue
      installed=1
      while read -r spec; do
        chroot "$TARGET" rpm -q --qf '%{NAME}\n' "$spec" >/dev/null 2>&1 || installed=0
      done < <(translate_one "$pkg")
      if (( ! installed )); then
        PKG_FAILURES+=("$pkg")
      fi
    done < <(grep -v '^#' "$ROOT/install/magikos-base.packages" | grep -v '^$')
    log "Fedora bootstrap complete; ${#PKG_FAILURES[@]} package(s) unmapped or unavailable."
  fi
}

# Replicates the magikos-settings package assembly of /etc/skel, which does
# not exist as a package yet: config/** maps under .config, default/bashrc
# becomes the dotfile, and shipped desktop entries land in .local/share.
assemble_skeleton() {
  local skel="$1"
  run mkdir -p "$skel/.config" "$skel/.local/share/applications"
  run cp -a "$ROOT/config/." "$skel/.config/"
  run cp -a "$ROOT/default/bashrc" "$skel/.bashrc"
  if [[ -d $ROOT/applications ]]; then
    run cp -a "$ROOT/applications/." "$skel/.local/share/applications/"
  fi
  # Magikos always launches the shell with an explicit path, but a bare
  # `quickshell` should still find it; point the default config at the tree.
  run mkdir -p "$skel/.config/quickshell"
  run ln -sfn "$PLANTED/shell" "$skel/.config/quickshell/default"
}

install_app_icons() {
  # applications/icons are single-size PNGs; hicolor wants them under the
  # standard size dirs so desktop lookups resolve.
  local prefix="$1" size
  if [[ ! -d $ROOT/applications/icons ]]; then
    return 0
  fi
  for size in 48x48 256x256; do
    run mkdir -p "$prefix/usr/share/icons/hicolor/$size/apps"
    run cp -a "$ROOT/applications/icons/." "$prefix/usr/share/icons/hicolor/$size/apps/"
  done
}

# System drop-ins we own outright. nsswitch.conf is the exception: its shape
# is distro-specific, so an Arch-flavored copy must never land on Fedora.
sync_etc_dropins() {
  local dest="$1"
  if [[ $BACKEND == dnf ]]; then
    run rsync -a --exclude=nsswitch.conf "$ROOT/etc/" "$dest/"
  else
    run rsync -a "$ROOT/etc/" "$dest/"
  fi
}

plant_magikos() {
  log "Planting the Magikos tree at /usr/share/magikos"

  run mkdir -p "$TARGET/usr/share/magikos"
  run rsync -a --delete \
    --exclude '.git/' --exclude 'test/' --exclude '*.log' \
    "$ROOT/" "$TARGET/usr/share/magikos/"

  # Shipped user defaults are seeded through /etc/skel, which useradd copies
  # at account creation (normally the magikos-settings package does this).
  run mkdir -p "$TARGET/etc/skel"
  assemble_skeleton "$TARGET/etc/skel"
  install_app_icons "$TARGET"
}

configure_target() {
  log "Configuring locale, clock, and fstab"

  if [[ $BACKEND == pacman ]]; then
    chroot_exec "locale-gen"
  fi
  chroot_exec "ln -sf /usr/share/zoneinfo/$(printf '%q' "$TIMEZONE") /etc/localtime"
  if [[ $BACKEND == pacman ]]; then
    chroot_exec "hwclock --systohc"
  fi

  # Written by hand rather than genfstab so both backends share one code path.
  local esp_uuid root_opts home_opts fstab
  esp_uuid=$(blkid -s UUID -o value "${DISK}1")
  root_opts="noatime,compress=zstd:1,subvol=@"
  home_opts="noatime,compress=zstd:1,subvol=@home"

  fstab=$(cat <<EOF
UUID=$esp_uuid  /boot       vfat    rw,umask=0077   0 2
UUID=$ROOT_UUID /           btrfs   $root_opts      0 0
UUID=$ROOT_UUID /home       btrfs   $home_opts      0 0
tmpfs           /tmp        tmpfs   rw,noatime      0 0
EOF
)
  write_file "$TARGET/etc/fstab" "$fstab"$'\n'
}

install_bootloader() {
  if [[ $BACKEND == pacman ]]; then
    log "Rebuilding UKIs and deploying Limine"
    chroot_exec "mkinitcpio -P"
    if chroot_exec "command -v limine-entry-tool" >/dev/null 2>&1; then
      chroot_exec "limine-entry-tool deploy || limine-entry-tool update" ||
        warn "limine-entry-tool could not deploy; verify the ESP boots before rebooting."
    else
      warn "limine-entry-tool is not present; the kernel hooks should have populated the ESP."
    fi
  else
    log "Installing systemd-boot [beta]"
    chroot_exec "bootctl install --esp-path=/boot --no-variables || bootctl install --esp-path=/boot"
    chroot_exec "kernel-install add-all || dracut -f --regenerate-all || true"
  fi
}

create_user() {
  log "Creating user $INSTALL_USER"

  # Neither distro repository carries oh-my-posh, so fresh installs get the
  # pinned upstream binary directly; the host-side helper only covers the
  # adopt-existing-system path.
  local omp_target="$TARGET/usr/local/bin/oh-my-posh"
  if (( DRY_RUN )) || [[ ! -x $omp_target ]]; then
    run mkdir -p "$TARGET/usr/local/bin"
    local omp_url="https://github.com/JanDeDobbeleer/oh-my-posh/releases/download/$OH_MY_POSH_VERSION/posh-linux-amd64"
    if run curl -fsSL "$omp_url" -o "$omp_target"; then
      run chmod 755 "$omp_target"
    else
      warn "Could not download oh-my-posh; fish will use its stock prompt."
      rm -f "$omp_target"
    fi
  fi

  chroot_exec "useradd -m -G wheel $(printf '%q' "$INSTALL_USER")"
  if (( ! DRY_RUN )); then
    local pass
    pass=$(ask_password "Password for $INSTALL_USER")
    printf '%s:%s\n' "$INSTALL_USER" "$pass" | chroot "$TARGET" chpasswd
  fi
}

apply_magikos() {
  log "Running Magikos system setup in the target"

  chroot_exec "env MAGIKOS_PATH=/usr/share/magikos \
    MAGIKOS_INSTALL=/usr/share/magikos/install \
    PATH=/usr/share/magikos/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
    bash /usr/share/magikos/bin/magikos-apply-system --install-user $(printf '%q' "$INSTALL_USER")"
}

report_pkg_failures() {
  if ((${#PKG_FAILURES[@]} > 0)); then
    warn "Packages that did not install (${#PKG_FAILURES[@]}):"
    printf '  %s\n' "${PKG_FAILURES[@]}"
    echo
  fi
}

finish() {
  log "Finishing up"
  run umount -R "$TARGET" || true
  if (( ENCRYPT )); then
    run cryptsetup close "$LUKS_NAME" || true
  fi

  report_pkg_failures
  log "Magikos installed on $DISK. You may reboot now."
  if [[ ${MAGIKOS_INSTALL_LOG_FILE:-} ]]; then
    log "Install log: $MAGIKOS_INSTALL_LOG_FILE"
  fi
}

# --- Existing-system adoption (--existing): everything below runs on the
# --- live host; no chroot, no partitioning, no bootloader changes.

PLANTED="/usr/share/magikos"
NERD_FONTS_VERSION="v3.5.0"
OH_MY_POSH_VERSION="v30.6.5"

# A previous installer version copied default/ flat into /etc/skel; none of
# those entries belong there (default/** lives under /usr/share/magikos).
clean_stale_skel_flat_copy() {
  local name
  while IFS= read -r name; do
    if [[ -e "/etc/skel/$name" || -L "/etc/skel/$name" ]]; then
      run rm -rf -- "/etc/skel/$name"
    fi
  done < <(find "$ROOT/default" -mindepth 1 -maxdepth 1 -printf '%f\n')
}

plant_magikos_host() {
  # Running straight out of the planted tree (packaged checkout or a
  # previous adoption): rsync --delete onto ourselves would be destructive.
  if [[ $(realpath "$ROOT") == "$PLANTED" ]]; then
    log "Tree is already planted at $PLANTED"
  else
    log "Planting the Magikos tree at $PLANTED"
    run mkdir -p "$PLANTED"
    run rsync -a --delete \
      --exclude '.git/' --exclude 'test/' --exclude '*.log' \
      "$ROOT/" "$PLANTED/"
  fi

  # Shipped user defaults are seeded through /etc/skel, which useradd copies
  # at account creation and seed_user_home replays for existing users.
  clean_stale_skel_flat_copy
  run mkdir -p /etc/skel
  assemble_skeleton /etc/skel
  install_app_icons ""

  sync_etc_dropins /etc

  write_file /etc/sudoers.d/10-magikos-wheel '%wheel ALL=(ALL:ALL) ALL'$'\n'
  if (( ! DRY_RUN )); then
    chmod 440 /etc/sudoers.d/10-magikos-wheel
  fi
}

install_packages_host() {
  log "Installing Magikos package set (best effort)"

  mapfile -t packages < <(grep -v '^#' "$ROOT/install/magikos-base.packages" | grep -v '^$')
  if (( ${#packages[@]} == 0 )); then
    die "No packages found in install/magikos-base.packages"
  fi

  if [[ $BACKEND == pacman ]]; then
    if ! run pacman -S --needed --noconfirm "${packages[@]}"; then
      warn "Batch install failed; falling back to per-package installs."
      local pkg
      for pkg in "${packages[@]}"; do
        if (( DRY_RUN )); then
          printf '[dry-run] pacman -S --needed %s\n' "$pkg"
        elif ! pacman -S --needed --noconfirm "$pkg" >>"$LOG_FILE" 2>&1; then
          PKG_FAILURES+=("$pkg")
        fi
      done
    fi
  else
    # --skip-broken must follow the subcommand on dnf5. A failed transaction
    # is not fatal here; the rpm audit below reports what did not land.
    load_dnf_map
    translate_packages "${packages[@]}"
    add_quickshell_repo "/etc"

    # power-profiles-daemon and tuned-ppd both provide ppd-service; whichever
    # already owns it wins, or the transaction aborts on the conflict.
    PPD_HELD_BY_TUNED=0
    if (( ! DRY_RUN )) && rpm -q tuned-ppd >/dev/null 2>&1; then
      PPD_HELD_BY_TUNED=1
      log "tuned-ppd already provides ppd-service; skipping power-profiles-daemon"
    fi
    local ppd_filtered=()
    local dnf_spec
    for dnf_spec in "${TRANSLATED_PACKAGES[@]}"; do
      if [[ $dnf_spec == "power-profiles-daemon" ]] && (( PPD_HELD_BY_TUNED )); then
        continue
      fi
      ppd_filtered+=("$dnf_spec")
    done
    TRANSLATED_PACKAGES=("${ppd_filtered[@]}")

    # One unresolvable name or conflict kills the whole batch transaction,
    # so a failed batch retries package by package; the audit below remains
    # the single source of truth for what is genuinely missing.
    if ! run dnf -y --setopt=install_weak_deps=False install --skip-broken "${TRANSLATED_PACKAGES[@]}"; then
      warn "Batch dnf transaction failed; retrying package by package."
      local dnf_spec
      for dnf_spec in "${TRANSLATED_PACKAGES[@]}"; do
        if (( DRY_RUN )); then
          printf '[dry-run] dnf install %s\n' "$dnf_spec"
        else
          dnf -y --setopt=install_weak_deps=False install "$dnf_spec" >>"$LOG_FILE" 2>&1 || true
        fi
      done
    fi
    if (( ! DRY_RUN )); then
      local pkg spec installed
      for pkg in "${packages[@]}"; do
        if [[ ${DNF_MAP[$pkg]+set} && ${DNF_MAP[$pkg]} == "-" ]]; then
          continue
        fi
        if [[ $pkg == "power-profiles-daemon" ]] && (( PPD_HELD_BY_TUNED )); then
          continue
        fi
        installed=1
        while read -r spec; do
          rpm -q --qf '%{NAME}\n' "$spec" >/dev/null 2>&1 || installed=0
        done < <(translate_one "$pkg")
        if (( ! installed )); then
          PKG_FAILURES+=("$pkg")
        fi
      done
    fi
  fi
}

adopt_user() {
  if (( DRY_RUN )); then
    return 0
  fi

  if id "$INSTALL_USER" >/dev/null 2>&1; then
    log "User $INSTALL_USER already exists; leaving the account as is"
    return 0
  fi

  log "Creating user $INSTALL_USER"
  run useradd -m -G wheel "$INSTALL_USER"
  local pass
  pass=$(ask_password "Password for $INSTALL_USER")
  printf '%s:%s\n' "$INSTALL_USER" "$pass" | run chpasswd
}

run_apply_system_host() {
  log "Running Magikos system setup"

  # --first-install marks shipped migrations complete instead of replaying
  # them over an adopted system; same thing the ISO does for its fresh user.
  local cmd="env MAGIKOS_PATH=$PLANTED \
    MAGIKOS_INSTALL=$PLANTED/install \
    PATH=$PLANTED/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
    bash $PLANTED/bin/magikos-apply-system --install-user $(printf '%q' "$INSTALL_USER") --first-install"

  if (( DRY_RUN )); then
    printf '[dry-run] %s\n' "$cmd"
  elif ! bash -c "$cmd"; then
    # One failing leaf aborts the whole chain (set -euo pipefail); that must
    # not lose the rest of the install.
    warn "magikos-apply-system reported errors; system setup may be incomplete."
    warn "Per-step output is in $LOG_FILE - fix and re-run this installer (it is idempotent)."
  fi
}

# useradd only replays /etc/skel for accounts it creates. An adopting user
# keeps their old $HOME until the skel tree is replayed over it (the same
# thing magikos-reinstall-configs does), then per-user finalization runs as
# that user -- it refuses root.
seed_user_home() {
  log "Syncing shipped defaults into ~$INSTALL_USER and finalizing"

  if (( DRY_RUN )); then
    printf '[dry-run] cp -af /etc/skel/. ~%s/\n' "$INSTALL_USER"
    printf '[dry-run] runuser -u %s -- magikos-provision-user --first-install\n' "$INSTALL_USER"
    return 0
  fi

  local home_dir
  home_dir=$(getent passwd "$INSTALL_USER" | cut -d: -f6)

  # --remove-destination keeps a skel file from being written *through* an
  # existing user symlink, which would truncate whatever the link targets.
  if ! runuser -u "$INSTALL_USER" -- env HOME="$home_dir" bash -c 'cp -a --remove-destination /etc/skel/. "$HOME/"'; then
    warn "Could not resync /etc/skel into ~$INSTALL_USER"
  fi

  if ! runuser -u "$INSTALL_USER" -- env \
    HOME="$home_dir" \
    MAGIKOS_PATH="$PLANTED" \
    MAGIKOS_INSTALL="$PLANTED/install" \
    PATH="$PLANTED/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin" \
    bash "$PLANTED/bin/magikos-provision-user" --first-install; then
    warn "Per-user finalization reported errors; re-run 'magikos finalize user' after first login."
  fi
}

finish_existing() {
  echo
  report_pkg_failures
  log "Magikos applied to the running system; ~$INSTALL_USER resynced from shipped defaults."
  warn "The bootloader was left untouched. Reboot into your current setup first, then adopt the UKI/Limine layout with 'magikos setup direct-boot' when ready."
  if [[ ${MAGIKOS_INSTALL_LOG_FILE:-} ]]; then
    log "Install log: $MAGIKOS_INSTALL_LOG_FILE"
  fi
}

# Fedora ships no Nerd Font packaging, so fetch the pinned upstream archive
# for the glyphs the shell's workspaces, network, bluetooth and battery
# widgets rely on. Arch installs the same glyphs via ttf-jetbrains-mono-nerd.
install_nerd_fonts_host() {
  if [[ $BACKEND == pacman ]]; then
    return 0
  fi

  local font_dir="/usr/local/share/fonts/JetBrainsMono-Nerd"
  if [[ -d $font_dir ]]; then
    log "JetBrainsMono Nerd Font already present at $font_dir"
    return 0
  fi

  local archive_url="https://github.com/ryanoasis/nerd-fonts/releases/download/$NERD_FONTS_VERSION/JetBrainsMono.tar.xz"
  log "Fetching JetBrainsMono Nerd Font $NERD_FONTS_VERSION"
  local tmp
  tmp=$(mktemp -d)
  if ! run curl -fsSL "$archive_url" -o "$tmp/JetBrainsMono.tar.xz"; then
    warn "Could not download JetBrainsMono Nerd Font; shell icons will fall back to text."
    rm -rf "$tmp"
    return 0
  fi
  run mkdir -p "$font_dir"
  if ! run tar -xJf "$tmp/JetBrainsMono.tar.xz" -C "$font_dir"; then
    warn "Could not unpack JetBrainsMono Nerd Font; shell icons will fall back to text."
  fi
  rm -rf "$tmp"
  if (( ! DRY_RUN )); then
    fc-cache -f "$font_dir" >>"$LOG_FILE" 2>&1 || true
  fi
}

# Neither distro's repositories carry oh-my-posh, so ship the pinned upstream
# binary when it is missing. The fish config guards its init, so systems
# without the binary simply keep the stock prompt.
install_oh_my_posh_host() {
  if command -v oh-my-posh >/dev/null 2>&1; then
    return 0
  fi

  local url="https://github.com/JanDeDobbeleer/oh-my-posh/releases/download/$OH_MY_POSH_VERSION/posh-linux-amd64"
  log "Installing oh-my-posh $OH_MY_POSH_VERSION"
  if ! run curl -fsSL "$url" -o /usr/local/bin/oh-my-posh; then
    warn "Could not download oh-my-posh; fish will use its stock prompt."
    rm -f /usr/local/bin/oh-my-posh
    return 0
  fi
  run chmod 755 /usr/local/bin/oh-my-posh
}

main() {
  preflight

  if (( EXISTING_MODE )); then
    plant_magikos_host
    install_packages_host
    install_nerd_fonts_host
    install_oh_my_posh_host
    adopt_user
    run_apply_system_host
    seed_user_home
    finish_existing
    return 0
  fi

  trap unmount_target EXIT

  partition_disk
  seed_target_config

  if [[ $BACKEND == pacman ]]; then
    bootstrap_arch
  else
    bootstrap_fedora
  fi

  plant_magikos
  configure_target
  install_bootloader
  create_user
  apply_magikos

  trap - EXIT
  finish
}

main
