#!/bin/bash

# magikos:summary=Launch a URL as a web app in the default supported browser
# magikos:args=<url>

browser=$(env -u BROWSER xdg-settings get default-web-browser)

case $browser in
google-chrome* | brave* | microsoft-edge* | opera* | vivaldi* | helium*) ;;
*) browser="chromium.desktop" ;;
esac

browser_exec=$(sed -n 's/^Exec=\([^ ]*\).*/\1/p' {~/.local,~/.nix-profile,/usr}/share/applications/$browser 2>/dev/null | head -1)

# uwsm-app is Arch-side; installs without uwsm launch the browser straight
# through its own --app= window so web apps still open as their own window.
if command -v uwsm-app >/dev/null 2>&1; then
  exec setsid uwsm-app -- "$browser_exec" --app="$1" "${@:2}"
else
  exec setsid "$browser_exec" --app="$1" "${@:2}"
fi
