#!/bin/bash

# magikos:summary=Restart the Magikos shell
# magikos:examples=magikos restart shell

# A caller opened after dev link/unlink may disagree with the still-running
# desktop. The user manager receives the session environment at login.
session_magikos_path=$(systemctl --user show-environment 2>/dev/null | sed -n 's/^MAGIKOS_PATH=//p' | tail -n 1)
: "${session_magikos_path:=$MAGIKOS_PATH}"

CONFIG_DIR="$session_magikos_path/shell"
[[ -f $CONFIG_DIR/shell.qml ]] || { echo "Magikos shell config not found: $CONFIG_DIR" >&2; exit 1; }

# Restarting a live lock client would kill the lock screen and strand the
# session behind the compositor's failsafe. But a LOCK session without an active
# locker — the shell died, or its crash handler re-execed a fresh instance
# that holds no lock — sits in that failsafe with no way to authenticate,
# and a restart plus re-lock is the only way back in without a reboot. So
# ask the lock service rather than merely pinging the shell: only a locker
# that reports the lock secure or in progress is worth preserving.
relock=0
locking=$(MAGIKOS_PATH="$session_magikos_path" MAGIKOS_SHELL_IPC_TIMEOUT=0.5s magikos-shell lock status 2>/dev/null |
  jq -r '.secure or .requested' 2>/dev/null)
if [[ $locking == "true" ]]; then
  echo "Refusing to restart Magikos shell while the session is locked." >&2
  exit 1
elif [[ -z $locking ]] && ! pgrep -x quickshell >/dev/null; then
  relock=1
fi

# The lock plugin loads asynchronously, so a fresh shell answers ping before
# it can lock, and may even refuse early lock requests while its plugins or
# PAM config are still loading. Mirror magikos-system-sleep-lock: request the
# lock and poll until the session reports secure, re-requesting as needed, so
# recovery never claims success while the failsafe is still up. The deadline
# is generous because slow plugin discovery delays the lock IPC target.
relock_session() {
  local state deadline=$((SECONDS + 30))

  while (( SECONDS < deadline )); do
    state=$(MAGIKOS_PATH="$session_magikos_path" MAGIKOS_SHELL_IPC_TIMEOUT=0.5s magikos-shell lock status 2>/dev/null |
      jq -r 'if .secure == true then "secure" elif .requested == true then "locking" else "idle" end' 2>/dev/null)

    case $state in
      secure) return 0 ;;
      locking) ;;
      *) MAGIKOS_PATH="$session_magikos_path" MAGIKOS_SHELL_IPC_TIMEOUT=0.5s magikos-shell lock lock >/dev/null 2>&1 ;;
    esac

    sleep 0.1
  done

  return 1
}

# Each kill stops the oldest matching instance. Stock quickshell releases
# return from kill before the process has fully exited, so drain the kill
# queue first, then wait out any surviving processes ourselves: the
# no-duplicate launch below must not race a dying shell.
while timeout 5 quickshell kill -p "$CONFIG_DIR" --any-display >/dev/null 2>&1; do :; done

survivor_deadline=$((SECONDS + 5))
while (( SECONDS < survivor_deadline )) && pgrep -x quickshell >/dev/null 2>&1; do
  sleep 0.05
done
if pgrep -x quickshell >/dev/null 2>&1; then
  echo "Quickshell instances are still shutting down; launching the replacement anyway." >&2
fi

# Spawn from the compositor so the shell inherits the canonical session environment,
# not transient variables from a terminal, SSH connection, or development tool.
# Sway's own MAGIKOS_PATH copy goes stale after a dev link or unlink without a
# re-login, so hand the freshly resolved session tree to the launcher explicitly.
swaymsg exec "env MAGIKOS_PATH='$session_magikos_path' magikos-launch-shell" >/dev/null 2>&1

for (( attempt = 0; attempt < 20; attempt++ )); do
  if MAGIKOS_PATH="$session_magikos_path" MAGIKOS_SHELL_IPC_TIMEOUT=0.5s magikos-shell shell ping >/dev/null 2>&1; then
    # The session stays compositor-locked after the old lock client died, so
    # re-acquire the lock and let the user authenticate out of it.
    if (( relock )) && ! relock_session; then
      echo "Magikos shell restarted, but the session lock was not re-secured." >&2
      exit 1
    fi
    # Invitation toasts (like Voxtype/fingerprint setup) die with the old
    # shell, and their notify-send waiters hang forever: the dying server
    # never emits NotificationClosed. A still-running magikos-*-invitation
    # unit is therefore an unanswered invitation — re-run it so its toast
    # reappears on the new shell. Answered invitations have already exited
    # and been collected, so the glob no longer matches them.
    systemctl --user try-restart 'magikos-*-invitation.service' 2>/dev/null || true
    exit 0
  fi
  sleep 0.1
done

echo "Magikos shell did not become ready after restart." >&2
exit 1
